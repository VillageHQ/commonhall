{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "ios": { "simulator": true }
    },
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "ios": { "simulator": true }
    },
    "production": {
      "autoIncrement": true,
      "android": { "buildType": "app-bundle" }
    },
    "testflight": {
      "extends": "production",
      "ios": { "credentialsSource": "local" }
    }
  },
  "submit": {
    "production": {},
    "testflight": {
      "ios": { "ascAppId": "6836913644", "appleTeamId": "TA6D5Y2M2U" }
    }
  }
}
